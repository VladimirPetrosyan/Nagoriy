# Copy to server/.env on the VPS (git-ignored — never commit real secrets).
# docker-compose.yml reads this file automatically.

# SMTP server that will relay the mail. Defaults to Yandex's if not set.
SMTP_HOST=smtp.yandex.ru

# 465 = implicit TLS (Yandex's default). Use 587 for STARTTLS instead.
SMTP_PORT=465

# Mailbox used to authenticate with the SMTP server — usually the same
# address the mail is being sent to. For Yandex you MUST use an app
# password here, not the normal account password:
# Yandex ID → Security → App passwords → create one with "Mail" access.
SMTP_USER=realty.experta@yandex.ru
SMTP_PASS=

# Recipient of the callback-form submissions.
EMAIL_TO=realty.experta@yandex.ru

# Optional — "From" address on the outgoing mail. Defaults to SMTP_USER.
EMAIL_FROM=
