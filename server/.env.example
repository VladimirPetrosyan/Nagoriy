# Copy to server/.env on the VPS (git-ignored — never commit real secrets).
# docker-compose.yml reads this file automatically.

# Bot token from @BotFather, looks like "123456789:AAExampleTokenTextHere"
TELEGRAM_BOT_TOKEN=

# Numeric chat id of the person the bot should message — NOT a t.me/...
# link and NOT an @username. Find it by having that person message the bot
# once (e.g. /start), then opening in a browser:
#   https://api.telegram.org/bot<YOUR_TOKEN>/getUpdates
# and reading the "chat":{"id": ...} field from the reply.
TELEGRAM_CHAT_ID=

# Optional — only needed if this server's own outbound network can't reach
# api.telegram.org directly (e.g. many Russian VPS providers get blocked/
# filtered by ISP-level DPI, even though api.telegram.org works fine from
# elsewhere). Leave both blank to call Telegram directly.
#
# Set these up once by deploying cloudflare-relay/worker.js as a Cloudflare
# Worker (free tier): dashboard → Workers & Pages → Create Worker → paste
# that file's contents → Deploy. Then in the Worker's Settings → Variables,
# add RELAY_SECRET as a *secret* (any long random string you make up) — use
# that same value below.
TELEGRAM_RELAY_URL=
TELEGRAM_RELAY_SECRET=
