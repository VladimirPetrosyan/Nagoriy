# Copy to server/.env on the VPS (git-ignored — never commit real secrets).
# docker-compose.yml reads this file automatically.

# Bot token from @BotFather, looks like "123456789:AAExampleTokenTextHere"
TELEGRAM_BOT_TOKEN=

# Numeric chat id of the person the bot should message — NOT a t.me/...
# link and NOT an @username. Find it by having that person message the bot
# once (e.g. /start), then opening in a browser:
#   https://api.telegram.org/bot<YOUR_TOKEN>/getUpdates
# and reading the "chat":{"id": ...} field from the reply.
TELEGRAM_CHAT_ID=
